{
  "name": "ethiohire",
  "version": "1.0.0",
  "private": true,
  "description": "EthioHire — Multi-tenant SaaS recruitment platform",
  "scripts": {
    "dev:backend": "pnpm --filter api run start:dev",
    "dev:frontend": "pnpm --filter mobile run start",
    "build:backend": "pnpm --filter api run build",
    "db:migrate": "pnpm --filter api run prisma:migrate",
    "db:seed": "pnpm --filter api run prisma:seed",
    "db:studio": "pnpm --filter api run prisma:studio"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}