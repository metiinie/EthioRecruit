{
    "expo": {
        "name": "EthioHire",
        "slug": "ethiohire",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "automatic",
        "scheme": "ethiohire",
        "splash": {
            "backgroundColor": "#0F172A"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.ethiohire.app"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#0F172A"
            },
            "package": "com.ethiohire.app"
        },
        "web": {
            "bundler": "metro",
            "output": "single",
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            "expo-font"
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}