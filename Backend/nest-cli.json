{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "builder": "swc",
        "typeCheck": true,
        "swcOptions": {
            "sourceMaps": true,
            "module": {
                "type": "commonjs"
            },
            "jsc": {
                "parser": {
                    "syntax": "typescript",
                    "decorators": true
                },
                "transform": {
                    "legacyDecorator": true,
                    "decoratorMetadata": true
                },
                "target": "es2021"
            }
        }
    }
}