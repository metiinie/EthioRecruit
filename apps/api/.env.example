# ============================================
# EthioHire API — Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ethiohire?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-64-character-random-string-for-user-jwt-signing"
ADMIN_JWT_SECRET="change-me-to-a-different-64-character-random-string-for-admin-jwt"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMS Ethiopia
SMS_ETHIOPIA_API_KEY=""
SMS_ETHIOPIA_SENDER_ID=""

# Sentry
SENTRY_DSN=""

# App
PORT=3000
NODE_ENV="development"
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
